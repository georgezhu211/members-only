<h1>Your Dossier</h1>

<p><strong>ID:</strong> <%= user.id %></p>
<p><strong>Alias:</strong> <%= user.username %></p>
<p><strong>First Name:</strong> <%= user.first_name %></p>
<p><strong>Last Name:</strong> <%= user.last_name %></p>
<p><strong>Inner Circle:</strong> <%= user.is_member ? '✓ Initiated' : '✗ Outsider' %></p>
<p><strong>Council Elder:</strong> <%= user.is_admin ? '✓ Ascended' : '✗ Not yet' %></p>
<p><strong>Inducted:</strong> <%= user.created_at.toLocaleString() %></p>

<% if (!locals.user.is_member) {%>
<form action="/users/me/membership" method="POST">
  <label for="clubPasscode">Speak the secret phrase</label>
  <input id="clubPasscode" name="clubPasscode" type="text" placeholder="Those who know, know..." />
  <button type="submit">Request Initiation</button>
</form>
<% } %>

<% if (!locals.user.is_admin) {%>
<form action="/users/me/admin" method="POST">
  <label for="adminPasscode">Elder's passphrase</label>
  <input id="adminPasscode" name="adminPasscode" type="text" placeholder="The deeper mystery..." />
  <button type="submit">Ascend to the Council</button>
</form>
<% } %>
<%- include("../partials/errors.ejs") %>
