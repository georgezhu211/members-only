<h1>The Archives</h1>
<% for (const message of messages) { %>
<hr />
<div>
  <h3><%= message.title %></h3>
  <p><%= message.content %></p>
  <small>Inscribed: <%= message.created_at.toLocaleString() %></small>
  <p>
    <a href="/messages/<%= message.id %>">Read</a>
    <a href="/messages/<%= message.id %>/edit">Amend</a>
  </p>
  <form
    action="/messages/<%= message.id %>/delete"
    method="POST"
    style="display: inline"
  >
    <button
      type="submit"
      onclick="return confirm('Banish this message to the void?');"
    >
      Destroy
    </button>
  </form>
</div>
<% } %>
<hr />

<a href="/messages/new">⚶ Inscribe new message</a>
