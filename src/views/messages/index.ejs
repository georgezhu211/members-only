<h1>Messages</h1>
<% for (const message of messages) { %>
<hr />
<div>
  <h3><%= message.title %></h3>
  <p><%= message.content %></p>
  <small><%= message.created_at %></small>
  <a href="/messages/<%= message.id %>">View</a>
  <a href="/messages/<%= message.id %>/edit">Edit</a>
</div>
<% } %>
<hr />

<a href="/messages/new">Create message</a>
