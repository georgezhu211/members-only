<h1>Inscribe a Message</h1>
<%- include("../partials/errors.ejs") %>
<form action="/messages" method="POST">
  <div>
    <label for="title">Subject</label>
    <input
      type="text"
      name="title"
      id="title"
      placeholder="Title your decree..."
    />
  </div>

  <div>
    <label for="content">Your Words</label>
    <textarea
      name="content"
      id="content"
      rows="5"
      placeholder="Speak freely among brethren..."
    ></textarea>
  </div>

  <button type="submit">Seal & Send</button>
</form>

<a href="/">← Return to the sanctum</a>
