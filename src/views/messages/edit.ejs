<h1>Amend the Record</h1>
<%- include("../partials/errors.ejs") %>
<form action="/messages/<%= message.id %>/update" method="POST">
  <div>
    <label for="title">Subject</label>
    <input type="text" name="title" id="title" value="<%= message.title %>" />
  </div>

  <div>
    <label for="content">Your Words</label>
    <textarea name="content" id="content" rows="5">
<%= message.content %></textarea
    >
  </div>

  <button type="submit">Seal Changes</button>
</form>

<a href="/messages">← Return to archives</a>
