<h1>Edit Message</h1>

<form action="/messages/<%= message.id %>/update" method="POST">
  <div>
    <label for="title"><strong>Title:</strong></label>
    <br />
    <input type="text" name="title" id="title" value="<%= message.title %>" />
  </div>

  <br />
  <div>
    <label for="content"> <strong>Message:</strong></label>
    <br />
    <textarea name="content" id="content" rows="5" cols="40">
<%= message.content %></textarea
    >
  </div>

  <button type="submit">Submit</button>
</form>

<a href="/messages">← Return</a>
