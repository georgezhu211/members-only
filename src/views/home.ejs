<h1>Messages</h1>
<% for (const message of messages) { %>
<hr />
<div>
  <h3><%= message.title %></h3>
  <p><%= message.content %></p>
  <% if (locals.user?.is_member) {%>
  <p>
    by <%= message.username %>
    <small><%= message.created_at.toLocaleString() %></small>
  </p>
  <% } %>
</div>
<% } %>
