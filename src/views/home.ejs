<h1>The Inner Circle</h1>
<p>Whispers from the society. <% if (locals.user) { %><a href="/messages">Enter the archives</a><% } else { %><a href="/auth/login">Prove your identity</a> to speak.<% } %></p>
<% for (const message of messages) { %>
<hr />
<div>
  <h3><%= message.title %></h3>
  <p><%= message.content %></p>
  <% if (locals.user?.is_member || locals.user?.is_admin) {%>
  <p>
    <small>⚶ @<%= message.username %> · <%= message.created_at.toLocaleString() %></small>
  </p>
  <% } %>
  <% if (locals.user?.is_admin) {%>
  <form
    action="/messages/<%= message.id %>/delete"
    method="POST"
    style="display: inline"
  >
    <button
      type="submit"
      onclick="return confirm('Banish this message to the void?');"
    >
      Destroy
    </button>
  </form>
  <% } %>
</div>
<% } %>
